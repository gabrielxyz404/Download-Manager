{
  "manifest_version": 3,
  "name": "PyDM - Integração com o navegador",
  "version": "0.3.0",
  "description": "Envia os downloads do navegador para o PyDM (gerenciador de downloads).",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PyDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "110"
}
